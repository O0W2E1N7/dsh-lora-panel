{
  "name": "dsh-lora-panel",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Read-only LoRA catalogue panel for the DeepSeek Harness left sidebar.",
  "license": "MIT",
  "author": "O0W2E1N7",
  "repository": {
    "type": "git",
    "url": "https://github.com/O0W2E1N7/dsh-lora-panel.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lora",
    "comfyui",
    "sidebar",
    "civitai"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "examples/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
